# Configure these in the shell or a local environment loader (Node does not load .env automatically).
METATRUTH_ADMIN_EMAIL=admin@example.invalid
METATRUTH_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters
METATRUTH_ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID
PORT=8787
BIND=127.0.0.1
# METATRUTH_DB_PATH=/absolute/path/to/metatruth.db
